# คัดลอกไฟล์นี้เป็น .env.local แล้วกรอกค่าจากโปรเจกต์ Supabase ของคุณ
# Dashboard: Project Settings > API
# ห้าม commit ไฟล์ .env.local หรือใส่ค่าจริงลงในไฟล์นี้

# URL ของโปรเจกต์ Supabase เช่น https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon/Public key (ปลอดภัยสำหรับใช้ฝั่ง client เนื่องจากถูกจำกัดสิทธิ์ด้วย RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- ใช้เฉพาะฝั่งเซิร์ฟเวอร์เท่านั้น (ห้ามใส่ prefix NEXT_PUBLIC_ และห้ามส่งให้ client เด็ดขาด) ---
# Service role key ข้าม Row Level Security ทั้งหมด จำเป็นสำหรับ:
#   - สร้าง Signed URL อ่าน/ดาวน์โหลดไฟล์ PDF ใน private bucket (lib/supabase/service.ts)
#   - สคริปต์ seed/migration ฝั่งเซิร์ฟเวอร์
# หากไม่ได้ตั้งค่าไว้ ฟีเจอร์ที่เกี่ยวข้องกับไฟล์ PDF (อ่าน/ดาวน์โหลด) จะใช้งานไม่ได้
# และจะแสดงข้อความแจ้งเตือนที่ชัดเจนแทนการ error แบบไม่ทราบสาเหตุ
SUPABASE_SERVICE_ROLE_KEY=

# --- ทางเลือก (Optional) — ฟีเจอร์ Super Admin บางส่วนเท่านั้นที่ต้องใช้ ---
# ไม่มีค่าเหล่านี้ระบบยังใช้งานได้ปกติ เพียงแต่ฟีเจอร์ที่เกี่ยวข้องจะแสดงสถานะ
# "ยังไม่ได้ตั้งค่า" ในหน้า /superadmin/security และ /superadmin/notifications
# วิธีตั้งค่าโดยละเอียด: ดู docs/superadmin-guide.md

# Cloudflare Turnstile (CAPTCHA, มี free tier) — NEXT_PUBLIC_ เพราะต้องใช้ฝั่ง client ด้วย
# ตั้งค่าทั้งสองตัวแปรให้ครบ แล้วเปิดสวิตช์ "เปิดใช้งาน CAPTCHA" ที่
# /superadmin/security จึงจะบังคับตรวจสอบ token จริงที่ฟอร์มสมัครสมาชิก
# (/register) และฟอร์มส่งงานวิจัยใหม่ (/submit-research) — เปิดสวิตช์ไว้แต่
# ตั้งค่าไม่ครบจะ fail-open (ไม่บล็อกผู้ใช้) ไม่ใช่ error
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (ส่งอีเมลแจ้งเตือนเมื่อสถานะงานวิจัยเปลี่ยน, มี free tier)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Malware Scanning (ทางเลือกตอน dev, จำเป็นก่อนขึ้น production) ---
# ไฟล์อัปโหลดทุกไฟล์ (PDF/ภาพปก/เอกสารแนบ) ถูกดาวน์โหลดกลับมาตรวจ magic-byte
# และสแกนมัลแวร์ฝั่งเซิร์ฟเวอร์ก่อนบันทึกข้อมูลเสมอ (lib/security/) — ไม่ตั้งค่า
# ตัวแปรด้านล่างเลย ระบบจะใช้ "โหมดจำลอง" (ข้ามการสแกนจริง) ได้เฉพาะตอน
# NODE_ENV ไม่ใช่ production เท่านั้น พร้อมคำเตือนใน server log ทุกครั้ง
# ดูรายละเอียดสัญญา (contract) ของ MALWARE_SCAN_API_URL ที่ docs/file-security.md
#
# เลือก provider ได้ค่าเดียว: "clamav" หรือ "http" (ปล่อยว่าง = ไม่มี provider จริง)
MALWARE_SCAN_PROVIDER=

# ใช้เมื่อ MALWARE_SCAN_PROVIDER=clamav — ที่อยู่ ClamAV daemon (clamd)
CLAMAV_HOST=
CLAMAV_PORT=3310

# ใช้เมื่อ MALWARE_SCAN_PROVIDER=http — บริการสแกนภายนอกของคุณเอง (ต้องรับ
# multipart/form-data ฟิลด์ "file" แล้วตอบ JSON { "clean": boolean, "threat"?: string })
MALWARE_SCAN_API_URL=
MALWARE_SCAN_API_KEY=

# บังคับให้ต้องมี provider ที่ใช้งานได้จริงหรือไม่ — ปล่อยว่างจะบังคับอัตโนมัติ
# เมื่อ NODE_ENV=production เท่านั้น (แนะนำให้ปล่อยว่างเสมอ) ตั้งเป็น "true"/
# "false" เพื่อ override พฤติกรรมอัตโนมัติ (เช่น ทดสอบโหมดบังคับใน dev)
# เมื่อบังคับแล้วแต่ provider ใช้งานไม่ได้ ระบบจะปฏิเสธการอัปโหลดทุกไฟล์
MALWARE_SCAN_REQUIRED=

# --- Background Jobs (จำเป็นก่อนขึ้น production ถ้าต้องการให้คิวประมวลผลอัตโนมัติ) ---
# Secret สุ่มยาวๆ (เช่น `openssl rand -hex 32`) สำหรับป้องกัน endpoint
# /api/jobs/process ไม่ให้ใครเรียกได้นอกจาก Cron ที่ตั้งค่าไว้ — ไม่ตั้งค่าตัวแปร
# นี้ endpoint จะปฏิเสธทุกคำขอเสมอ (fail closed) ใช้ค่าเดียวกันนี้ได้กับผู้เรียก
# หลายรายพร้อมกันอย่างปลอดภัย (เช่น ตั้ง scheduler ภายนอกมากกว่าหนึ่งตัว หรือ
# worker หลาย instance จริงใน production — ระบบคิวจัดการ concurrency ให้เองที่
# ระดับฐานข้อมูล ดู docs/background-jobs.md หัวข้อ 13) ดูวิธีตั้งค่า Cron Job
# สำหรับ Production ที่ docs/background-jobs.md หัวข้อ 6.2
#
# ใช้ค่าเดียวกันนี้กับ /api/cron/health-check ด้วย (ช่วงที่ 31 — endpoint
# watchdog ตรวจสุขภาพ cron/worker แยกต่างหาก ต้องตั้งเป็น Cron ที่สอง อิสระ
# จาก /api/jobs/process จริง ไม่ใช่ scheduler เดียวกัน — ดู docs/background-jobs.md
# หัวข้อ 6.3/14 และ docs/production-checklist.md หัวข้อ 18)
CRON_SECRET=

# --- Centralized Logging (ทางเลือก) — ไม่ตั้งค่าก็ใช้งานได้ปกติ ---
# ไม่มีค่าเหล่านี้ ระบบจะ log ผ่าน console/server logging เท่านั้น (พฤติกรรมเดิม
# ดูใน terminal ตอน dev หรือ Vercel Runtime Logs ตอน production) — ตั้งค่าเพื่อ
# ส่ง error ของแอปพลิเคชัน (ผ่านการตัดข้อมูลอ่อนไหวออกแล้ว) ไปยัง provider ภายนอก
# โดยอัตโนมัติ **เฉพาะตอน production เท่านั้น** (NODE_ENV=production — dev จะยัง
# log ผ่าน console เสมอ ไม่ส่งออกนอกเครื่อง) ดูรายละเอียดที่ lib/logging/
#
# LOG_PROVIDER เลือกได้ค่าเดียว: "sentry" หรือ "betterstack" (ปล่อยว่างเพื่อปิด)
LOG_PROVIDER=

# ใช้เมื่อ LOG_PROVIDER=sentry — DSN จากโปรเจกต์ Sentry (Settings > Client Keys)
SENTRY_DSN=

# ใช้เมื่อ LOG_PROVIDER=betterstack — Source Token จาก Better Stack (Logtail)
LOGGING_BETTERSTACK_SOURCE_TOKEN=
# เปลี่ยนได้หากบัญชี Better Stack ใช้ ingestion endpoint อื่น (ปกติไม่ต้องตั้งค่า)
LOGGING_BETTERSTACK_INGEST_URL=

# --- ORCID OAuth (ทางเลือก) — ไม่ตั้งค่าปุ่ม "เชื่อม ORCID" จะปิดพร้อมคำแนะนำ ---
# ใช้ยืนยันตัวตนผู้วิจัยผ่าน ORCID จริง (OAuth Authorization Code, Public API
# ฟรี scope /authenticate เท่านั้น — ไม่ใช่ Member API แบบเสียเงิน) สมัครแอปได้ที่
# https://orcid.org/developer-tools (production) หรือ https://sandbox.orcid.org
# (ทดสอบ) ดูขั้นตอนละเอียดที่ docs/orcid-integration.md
# Redirect URI ที่ต้องลงทะเบียนกับ ORCID: https://<โดเมนของคุณ>/api/orcid/callback
# (ระบบคำนวณ URL นี้จาก request header เอง ไม่ต้องตั้งค่าตัวแปรโดเมนแยก)
#
# ตัวแปรชุดนี้ (ORCID_CLIENT_ID/ORCID_CLIENT_SECRET/ORCID_OAUTH_ENV) ใช้ร่วมกัน
# ทั้งปุ่ม "เชื่อม ORCID" (OAuth) และปุ่ม "ตรวจสอบ ORCID" แบบอ่านอย่างเดียวผ่าน
# ORCID Public API (Client Credentials, ดู docs/orcid-integration.md หัวข้อ 6)
# — ไม่มีตัวแปรแยกสำหรับ Public API เพิ่มเติม ไม่มีค่าใช้จ่ายเพิ่มจากการเปิดใช้
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# เลือก "sandbox" (ทดสอบ, ค่าเริ่มต้นถ้าปล่อยว่างเพื่อความปลอดภัย) หรือ
# "production" (ORCID จริง) — ต้องตั้งเป็น "production" อย่างชัดเจนก่อนขึ้นระบบจริง
# มีผลกับทั้ง OAuth และ Public API พร้อมกัน
ORCID_OAUTH_ENV=

# --- OCR สำหรับ PDF ที่เป็นเอกสารสแกน (ทางเลือก) — ไม่ตั้งค่า ระบบจะไม่สร้าง ---
# --- ข้อความ/progress OCR ปลอมเด็ดขาด งานจะจบด้วยสถานะ "blocked" พร้อมเหตุผลเสมอ ---
# ทำงานเป็น background job แยกต่างหาก (ไม่รันตอนอัปโหลด) เมื่อการดึงข้อความ PDF
# ปกติได้ผล "ไม่พบข้อความ" (no_text_found) ดูรายละเอียดที่ docs/ocr-operations.md
# และขั้นตอนทดสอบ provider จริงก่อนขึ้น production ที่ docs/ocr-provider-validation.md
# (ช่วงที่ 32 เปลี่ยนชื่อ/รวม environment variable ชุดนี้ใหม่ทั้งหมด)
#
# เลือก provider ได้ 3 ค่า (ค่าอื่นนอกจากนี้ = ไม่มี provider จริง ไม่มีโหมด
# จำลอง/mock ใดๆ ทั้งใน dev และ production):
#   "none"         — ค่าเริ่มต้น/ไม่ได้ตั้งค่า
#   "self_hosted"  — synchronous รอบเดียว รอผลลัพธ์สุดท้ายในคำขอเดียว
#   "external_api" — async submit แล้ว poll สถานะแยก รองรับ progress ระดับหน้า
#                    ถ้า provider จริงรายงานได้ (ดูหัวข้อ 3 ของ docs/ocr-operations.md)
OCR_PROVIDER=

# URL/API key ของ provider ที่เลือกไว้ (ใช้ร่วมกันทั้ง self_hosted/external_api
# — ต่างกันแค่ path ที่เรียก): self_hosted รับ multipart/form-data ฟิลด์ "file"
# ที่ URL นี้ตรงๆ แล้วตอบ JSON { "text": string, "confidence"?: number,
# "language"?: string } — external_api รับที่ {URL}/jobs (POST, คืน 202
# { job_id, total_pages? }) แล้ว poll ที่ {URL}/jobs/{id} (GET, คืน { status,
# current_page?, total_pages?, text?, confidence?, language?, error? })
# ดูสัญญาเต็มที่ docs/ocr-operations.md หัวข้อ 3
OCR_PROVIDER_BASE_URL=
OCR_PROVIDER_API_KEY=

# timeout ต่อคำขอ HTTP หนึ่งครั้งไปยัง provider หน่วยมิลลิวินาที (ปล่อยว่าง =
# ค่าเริ่มต้น 120000 = 120 วินาที จำกัดช่วง 5000-300000)
OCR_PROVIDER_TIMEOUT_MS=

# ภาษาเป้าหมายที่ส่งให้ provider (ค่าเริ่มต้นถ้าปล่อยว่าง: "tha+eng")
OCR_LANGUAGES=

# ต้องตั้งเป็น "true" อย่างชัดเจนเท่านั้น ระบบจึงจะยอมเรียก OCR provider จริง
# (แม้เป็นบริการ self-host ขององค์กรเองก็ยังนับเป็นการส่งข้อมูลออกนอก process
# นี้) ปล่อยว่างหรือค่าอื่นใด = ปฏิเสธการสร้างงาน OCR จริงเสมอ (fail closed —
# แต่ Controlled OCR Test ยังทดสอบได้ผ่าน OCR_TEST_MODE ด้านล่างแยกต่างหาก)
# ดูรายละเอียด privacy/copyright ที่ docs/file-security.md และ docs/ocr-operations.md
OCR_ENABLED=false

# ใช้เฉพาะ provider แบบ external_api เท่านั้น — เอกสารที่ระดับการเข้าถึงไม่ใช่
# "public" ต้องได้รับอนุมัติเพิ่มอีกชั้นนี้ก่อนถึงจะส่งไปยังผู้ให้บริการภายนอกได้
# (self_hosted ไม่ตรวจเงื่อนไขนี้ — ถือว่าอยู่ในโครงสร้างพื้นฐานขององค์กรเอง)
# ปล่อยว่างหรือค่าอื่นใด = ปฏิเสธเสมอ (fail closed)
OCR_ALLOW_PRIVATE_DOCUMENTS=false

# เปิดใช้ Controlled OCR Test ที่ /superadmin/ocr (Super Admin ทดสอบ provider
# ด้วยไฟล์ fixture ที่ไม่เป็นความลับเท่านั้น) — ตั้งใจให้เป็นอิสระจาก OCR_ENABLED
# เพื่อตรวจสอบ provider ได้ก่อนเปิดใช้งานจริงกับผู้ใช้ทั่วไป แนะนำเปิดใน
# staging ก่อนเสมอ ดูขั้นตอนเต็มที่ docs/ocr-provider-validation.md
OCR_TEST_MODE=false

# เพดานสูงสุด (ปรับได้แค่ตอน deploy) ของขนาดไฟล์/จำนวนหน้า/จำนวนงาน OCR ต่อ
# ผู้ใช้ต่อวัน — ค่าที่ใช้บังคับจริงคือ min(เพดานนี้, ค่าที่ Super Admin ตั้งไว้
# แบบ live ที่ /superadmin/ocr) ปล่อยว่างช่องใดช่องหนึ่ง = ไม่มีเพดานเพิ่มจาก
# env ในช่องนั้น (ใช้ค่าจาก Settings ของ DB อย่างเดียว) ดู docs/ocr-operations.md
# หัวข้อ 6
OCR_MAX_FILE_SIZE_MB=
OCR_MAX_PAGES=
OCR_MAX_JOBS_PER_DAY=
